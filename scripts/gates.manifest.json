{
  "$comment": "verify 范围化清单(包 ar,2026-08-17)。每道重门/每个链步骤声明自己的输入文件集(glob,path.matchesGlob 语义);scoped 模式下改动集∩inputs=∅ 才跳过。未在此声明的门一律照跑;globals 命中即整轮升 full;kind=runtime|server 的在 static 模式一律跳过。改本文件 = 改门定义,自动属于 globals。接线一致性由 `node scripts/lib/verify-scope.mjs lint` 守(verify.sh 也跑它)。",
  "globals": [
    "scripts/verify.sh",
    "scripts/gates.manifest.json",
    "scripts/lib/**",
    "scripts/verify-chain.mjs",
    "scripts/typecheck-cached.mjs",
    "scripts/run-legacy-suite.mjs",
    "scripts/verify-h5-runtime.mjs",
    "package.json",
    "package-lock.json",
    "tsconfig*.json",
    "vite.config.ts",
    "vitest.config.ts",
    "uno.config.ts",
    "shims-uni.d.ts",
    "index.html",
    "src/pages.json",
    "src/App.vue",
    "src/main.ts",
    "src/manifest.json",
    "src/lib/route.ts",
    "src/components/app-chassis.vue",
    "src/components/global-ui.vue",
    "src/styles/**",
    "src/i18n/**",
    "src/api/runtime.ts",
    "src/api/runtime-config.ts",
    ".claude/hooks/**"
  ],
  "gates": {
    "route-http": {
      "kind": "server",
      "always": true,
      "$why": "[2] 路由 200 + 身份;有 server 就跑(0.7s),static 跳"
    },
    "api-mode-preflight": {
      "kind": "server",
      "always": true,
      "$why": "[2.5] mock 模式 + 树身份;有 server 就跑,static 跳"
    },
    "server-health-preflight": {
      "kind": "server",
      "always": true,
      "$why": "[2.7] shell 延迟环境门;有 server 就跑,static 跳"
    },
    "store-unreachable": {
      "kind": "static",
      "inputs": [
        "src/store/**",
        "src/api/**",
        "scripts/store-unreachable-code-gate.mjs"
      ]
    },
    "withdraw-rail-alias-redtest": {
      "kind": "static",
      "inputs": [
        "src/store/**",
        "src/api/**",
        "src/lib/**",
        "scripts/selfcheck-fastlane.mjs",
        "scripts/withdraw-rail-alias.redtest.mjs"
      ]
    },
    "pending-checkout-vitest": {
      "kind": "test",
      "inputs": [
        "src/store/**",
        "src/lib/**",
        "src/api/**",
        "src/mock/**"
      ]
    },
    "remote-refresh-resilience": {
      "kind": "static",
      "inputs": [
        "src/**",
        "scripts/selfcheck-remote-refresh-resilience.mjs"
      ]
    },
    "login-entry-chrome-runtime": {
      "kind": "runtime",
      "inputs": [
        "src/pages/onboarding/**",
        "src/pages/login/**",
        "src/pages/register/**",
        "src/pages/ref/**",
        "src/pages/session/**",
        "src/components/device/**",
        "src/components/captcha-slider.vue",
        "src/components/country-code-sheet.vue",
        "scripts/auth-system-chrome-runtime.mjs"
      ]
    },
    "spec6-entry-runtime": {
      "kind": "runtime",
      "inputs": [
        "src/pages/entry-surfaces/**",
        "src/components/entry-surfaces/**",
        "src/lib/entry-surface.ts",
        "src/store/**",
        "scripts/spec6-entry-surface-runtime.mjs"
      ]
    },
    "r7-device-runtime": {
      "kind": "runtime",
      "inputs": [
        "src/pages/index/**",
        "src/pages/earn/**",
        "src/pages/me/**",
        "src/components/home/**",
        "src/components/earn/**",
        "src/components/device/**",
        "src/store/**",
        "src/lib/hashpower.ts",
        "src/lib/device-*.ts",
        "scripts/r7-device-detail-runtime.mjs"
      ]
    },
    "spec7-k1-auth02-runtime": {
      "kind": "runtime",
      "inputs": [
        "src/pages/register/**",
        "src/pages/login/**",
        "src/store/**",
        "src/api/**",
        "scripts/spec7-risk-gate-runtime.mjs",
        "src/pages/onboarding/**",
        "src/lib/**",
        "scripts/auth-register-existing-runtime.mjs"
      ],
      "$why": "SPEC-7 K1 注册闸 + AUTH02 双语注册运行时同一 curl 块,共用一个 id"
    },
    "spec4-runtime": {
      "kind": "runtime",
      "inputs": [
        "src/store/**",
        "src/lib/**",
        "src/api/**",
        "scripts/spec4-account-cloud-app-sync.mjs",
        "src/pages/me/**",
        "src/pages/session/**",
        "scripts/spec4-runtime-session-guard.mjs"
      ],
      "$why": "SPEC-4 app-sync + session guard 同一 curl 块,共用一个 id"
    },
    "theme-constant-runtime": {
      "kind": "runtime",
      "inputs": [
        "src/**/*.vue",
        "src/**/*.css",
        "src/**/*.scss",
        "docs/THEME-CONSTANT-BASELINE.json",
        "scripts/theme-constant-gate.mjs"
      ]
    },
    "zero-border-runtime": {
      "kind": "runtime",
      "inputs": [
        "src/**/*.vue",
        "src/**/*.css",
        "src/**/*.scss",
        "docs/ZERO-BORDER-BASELINE.json",
        "docs/ZERO-BORDER-ALLOWLIST.json",
        "scripts/zero-border-gate.mjs"
      ]
    },
    "dom-qa-runtime": {
      "kind": "runtime",
      "inputs": [
        "src/pages/**",
        "src/components/**",
        "src/store/**",
        "docs/DOM-QA-LEDGER.json",
        "scripts/dom-qa.mjs"
      ]
    },
    "tap-feedback-runtime": {
      "kind": "runtime",
      "inputs": [
        "src/pages/**",
        "src/components/**",
        "docs/TAP-FEEDBACK-LEDGER.json",
        "scripts/tap-feedback-probe.mjs"
      ]
    },
    "orphan-line-runtime": {
      "kind": "runtime",
      "inputs": [
        "src/pages/**",
        "src/components/**",
        "scripts/orphan-line-probe.mjs"
      ]
    },
    "empty-state-runtime": {
      "kind": "runtime",
      "inputs": [
        "src/pages/**",
        "src/components/**",
        "src/store/**",
        "scripts/empty-state-probe.mjs"
      ]
    },
    "withdraw-bill-runtime": {
      "kind": "runtime",
      "inputs": [
        "src/pages/me/**",
        "src/store/**",
        "src/api/**",
        "src/lib/**",
        "scripts/withdraw-bill-runtime.mjs",
        "scripts/verify-h5-runtime.mjs"
      ]
    },
    "h5-runtime-isolated": {
      "kind": "runtime",
      "inputs": [
        "src/**",
        "scripts/verify-h5-runtime.mjs",
        "scripts/guard-liveness-runtime.mjs",
        "scripts/auth-guard-verify.mjs",
        "scripts/business-loop-liveness-runtime.mjs",
        "scripts/spec6-entry-surface-runtime.mjs",
        "scripts/trial-check.mjs",
        "scripts/sticky-check.mjs",
        "scripts/backnav-check.mjs",
        "scripts/profile-identity-check.mjs",
        "scripts/pending-checkout-runtime.mjs",
        "scripts/page-check.mjs"
      ],
      "$why": "runner 已跑过同树 → verify.sh 复用;否则按 h5Probes 子探针级缩范围"
    }
  },
  "steps": {
    "type-check:cached": {
      "kind": "static",
      "always": true,
      "$why": "走 typecheck-cached(指纹缓存 + vue-tsc --incremental)"
    },
    "test:contract-registry": {
      "kind": "test",
      "inputs": [
        "src/**",
        "scripts/**"
      ]
    },
    "test:cross-repo": {
      "kind": "test",
      "inputs": [
        "src/**",
        "scripts/**"
      ]
    },
    "test:kyc-removal": {
      "kind": "test",
      "inputs": [
        "src/**",
        "scripts/**"
      ]
    },
    "test:probe-safety": {
      "kind": "test",
      "inputs": [
        "src/**",
        "scripts/**"
      ]
    },
    "test:earnings-accrual": {
      "kind": "test",
      "inputs": [
        "src/**",
        "scripts/**"
      ]
    },
    "test:business-loop-liveness": {
      "kind": "test",
      "inputs": [
        "src/**",
        "scripts/**"
      ]
    },
    "test:janus-stop-cancellation": {
      "kind": "test",
      "inputs": [
        "src/**",
        "scripts/**"
      ]
    },
    "test:production-boundaries": {
      "kind": "test",
      "inputs": [
        "src/**",
        "scripts/**"
      ]
    },
    "test:session-reload-recovery": {
      "kind": "runtime",
      "inputs": [
        "src/**",
        "scripts/server-session-reload-recovery*.mjs",
        "scripts/verify-h5-runtime.mjs"
      ]
    },
    "test:guard-liveness": {
      "kind": "test",
      "inputs": [
        "src/**",
        "scripts/**"
      ]
    },
    "test:a11y-activate": {
      "kind": "test",
      "inputs": [
        "src/**",
        "scripts/**"
      ]
    },
    "test:learning-contracts": {
      "kind": "test",
      "inputs": [
        "src/**",
        "scripts/**"
      ]
    },
    "test:real-backend-integration": {
      "kind": "test",
      "inputs": [
        "src/**",
        "scripts/**"
      ]
    },
    "build:h5": {
      "kind": "build",
      "always": true,
      "fullOnly": true,
      "$why": "生产构建只在 full 档;scoped/static 不跑"
    },
    "test:h5-runtime": {
      "kind": "runtime",
      "inputs": [
        "src/**",
        "scripts/verify-h5-runtime.mjs",
        "scripts/*-check.mjs",
        "scripts/*-runtime.mjs",
        "scripts/auth-guard-verify.mjs"
      ],
      "$why": "子探针级缩范围见 h5Probes"
    },
    "test:withdraw-status-mirror": {
      "kind": "runtime",
      "inputs": [
        "src/store/**",
        "src/pages/me/**",
        "src/api/**",
        "src/lib/**",
        "scripts/withdraw-status-mirror-runtime.mjs"
      ]
    },
    "test:legacy-suite": {
      "kind": "meta",
      "always": true,
      "$why": "verify.sh 自己按 gates 缩范围(VERIFY_MODE 透传);kind=meta:full/scoped 由 runner 起服后经 run-legacy-suite 跑,static 由 runner 直接以 VERIFY_MODE=static 裸跑 verify.sh(不起服),三档都跑"
    }
  },
  "h5Probes": {
    "guard-liveness-runtime": {
      "kind": "runtime",
      "inputs": [
        "src/store/**",
        "src/lib/**",
        "src/pages/onboarding/**",
        "src/pages/login/**",
        "scripts/guard-liveness-runtime.mjs"
      ]
    },
    "auth-guard-verify": {
      "kind": "runtime",
      "inputs": [
        "src/store/**",
        "src/lib/**",
        "src/pages/onboarding/**",
        "src/pages/login/**",
        "src/pages/register/**",
        "scripts/auth-guard-verify.mjs"
      ]
    },
    "business-loop-liveness-runtime": {
      "kind": "runtime",
      "inputs": [
        "src/store/**",
        "src/lib/**",
        "src/pages/index/**",
        "src/pages/earn/**",
        "src/components/home/**",
        "src/components/earn/**",
        "scripts/business-loop-liveness-runtime.mjs"
      ]
    },
    "spec6-entry-surface-runtime": {
      "kind": "runtime",
      "inputs": [
        "src/pages/entry-surfaces/**",
        "src/components/entry-surfaces/**",
        "src/lib/entry-surface.ts",
        "src/store/**",
        "scripts/spec6-entry-surface-runtime.mjs"
      ]
    },
    "trial-check": {
      "kind": "runtime",
      "inputs": [
        "src/pages/**",
        "src/components/trial-*.vue",
        "src/components/store/**",
        "src/store/**",
