      ]
    },
    "sticky-check": {
      "kind": "runtime",
      "inputs": [
        "src/pages/**",
        "src/components/**",
        "scripts/sticky-check.mjs"
      ]
    },
    "backnav-check": {
      "kind": "runtime",
      "inputs": [
        "src/pages/**",
        "src/components/**",
        "src/lib/**",
        "scripts/backnav-check.mjs"
      ]
    },
    "profile-identity-check": {
      "kind": "runtime",
      "inputs": [
        "src/pages/me/**",
        "src/components/me/**",
        "src/store/**",
        "src/lib/**",
        "scripts/profile-identity-check.mjs"
      ]
    },
    "pending-checkout-runtime": {
      "kind": "runtime",
      "inputs": [
        "src/pages/store/**",
        "src/components/store/**",
        "src/components/pending-checkout-bar.vue",
        "src/store/**",
        "src/lib/**",
        "scripts/pending-checkout-runtime.mjs"
      ]
    },
    "page-check": {
      "kind": "runtime",
      "inputs": [
        "src/pages/index/**",
        "src/components/home/**",
        "src/store/**",
        "scripts/page-check.mjs"
      ]
    }
  }
}
