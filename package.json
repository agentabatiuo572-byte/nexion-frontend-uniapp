    "verify": "npm run type-check && npm run test:kyc-removal && npm run test:probe-safety && npm run test:earnings-accrual && npm run test:contracts && npm run test:business-loop-liveness && npm run test:janus-stop-cancellation && npm run test:production-boundaries && npm run test:session-reload-recovery && npm run test:guard-liveness && npm run test:a11y-activate && npm run test:learning-contracts && npm run build:h5 && npm run test:h5-runtime && npm run test:withdraw-status-mirror && npm run test:legacy-suite"
