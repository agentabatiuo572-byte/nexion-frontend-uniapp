# Acceptance H5 always uses the explicit server-owned sandbox. Its browser
# requests stay same-origin and Vite proxies /api to the isolated backend, so
# localhost and 127.0.0.1 never create separate browser identities.
VITE_NEXGRID_API_MODE=sandbox
# VITE_NEXGRID_API_BASE_URL=https://api.example.invalid
# Local H5 preview only: proxy the same-origin API gateway to the isolated
# loopback backend. This value is never embedded in the production bundle.
VITE_NEXGRID_API_PREVIEW_TARGET=http://127.0.0.1:8110
# VITE_NEXGRID_API_PREVIEW_EDGE_COUNTRY=JP
